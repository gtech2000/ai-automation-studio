{
  "name": "AI Lead Qualification",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromAList"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "options": {}
      },
      "name": "Webhook — Lead Capture",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const lead = items[0].json;\nconst errors = [];\nif (!lead.email) errors.push('email required');\nif (!lead.company) errors.push('company required');\nreturn [{ json: { ...lead, errors, valid: errors.length === 0 } }];"
      },
      "name": "Validate Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list"
        },
        "options": {
          "range": "A:E"
        }
      },
      "name": "Google Sheets — Dedupe",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "Score the lead 0-100 against the ideal customer profile. Return JSON: {\"score\": number, \"rationale\": string, \"nextAction\": string}"
            },
            {
              "role": "user",
              "content": "={{ JSON.stringify($json) }}"
            }
          ]
        },
        "jsonOutput": true
      },
      "name": "OpenAI — Score Lead",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "larger"
              }
            }
          ]
        }
      },
      "name": "Qualified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "channel": "sales-team",
        "text": "New qualified lead: {{ $json.company }} — score {{ $json.score }}/100. {{ $json.rationale }}"
      },
      "name": "Slack — Alert Sales",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Email": "={{ $json.email }}",
            "Company": "={{ $json.company }}",
            "Score": "={{ $json.score }}",
            "Rationale": "={{ $json.rationale }}",
            "Next Action": "={{ $json.nextAction }}",
            "Qualified At": "={{ $now }}"
          }
        }
      },
      "name": "Google Sheets — Save Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1340, 420]
    }
  ],
  "connections": {
    "Webhook — Lead Capture": {
      "main": [
        [
          {
            "node": "Validate Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Fields": {
      "main": [
        [
          {
            "node": "Google Sheets — Dedupe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets — Dedupe": {
      "main": [
        [
          {
            "node": "OpenAI — Score Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI — Score Lead": {
      "main": [
        [
          {
            "node": "Qualified?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Qualified?": {
      "main": [
        [
          {
            "node": "Slack — Alert Sales",
            "type": "main",
            "index": 0
          },
          {
            "node": "Google Sheets — Save Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
